#!/bin/sh
# Guard against reintroducing Python conversion/download scripts.
#
# The app consumes HuggingFace safetensors directly (see scripts/README.md and
# PolyJuiceVoice/Core/ML/WeightKeyMap.swift). Python conversion wrappers were
# removed because they silently masked Swift-side weight-key mismatches.
#
# Enable this hook once per clone:
#   git config core.hooksPath .githooks

set -e

staged=$(git diff --cached --name-only --diff-filter=AM)

# Block any new .py file under scripts/, except the two retained utilities.
forbidden=$(printf '%s\n' "$staged" | grep -E '^scripts/.*\.py$' \
    | grep -v -E '^scripts/(export_tokenizer|update_xcode_settings)\.py$' || true)

if [ -n "$forbidden" ]; then
    echo "pre-commit: rejected — new Python files under scripts/ are not allowed."
    echo ""
    echo "These files were removed in favor of direct HuggingFace downloads at runtime."
    echo "See scripts/README.md for the rationale."
    echo ""
    echo "Offending paths:"
    printf '  %s\n' "$forbidden"
    echo ""
    echo "If you genuinely need a new dev utility, update this hook's allowlist."
    exit 1
fi

# Block requirements.txt anywhere under scripts/.
if printf '%s\n' "$staged" | grep -qE '^scripts/requirements\.txt$'; then
    echo "pre-commit: rejected — scripts/requirements.txt is forbidden."
    echo "Python is no longer part of the build or runtime path."
    exit 1
fi
